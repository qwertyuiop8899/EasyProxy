# ==================================================
#         EasyProxy Configuration
# ==================================================
#
# Rename this file to ".env" and edit as needed.
# Most settings are now managed via the Admin Panel (live, no restart).
# Only essential env vars remain here.

# --- Required ---
# Password to protect the proxy API and admin panel
#API_PASSWORD=your_password_here

# --- Optional ---
# Server port (default: 7860)
#PORT=7860

# --- Embedded Toastflix sidecar ---
# The sidecar is exposed by EasyProxy under /sidecar and binds only to loopback.
# Leave the internal port empty to select a free local port automatically.
#SIDECAR_INTERNAL_PORT=0
#SIDECAR_STARTUP_TIMEOUT=20
#SIDECAR_CACHE_DIR=/data/recordings/sidecar_data
# For Toastflix root aliases, use the public EasyProxy base without /sidecar.
#SIDECAR_PUBLIC_URL=https://example.com
#SIDECAR_FIXED_TOKEN=
#SIDECAR_BOOTSTRAP_KEY=
#OFFSET_API_URL=
#OFFSET_API_TOKEN=
